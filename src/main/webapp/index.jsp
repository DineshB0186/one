.product{
    background:#fff;
    border-radius:16px;
    overflow:hidden;
    box-shadow:0 4px 20px rgba(0,0,0,.08);
    transition:all .3s ease;
}

.product:hover{
    transform:translateY(-8px);
    box-shadow:0 12px 30px rgba(0,0,0,.12);
}

.product img{
    height:250px;
    object-fit:cover;
    width:100%;
}

.add-btn{
    background:#2563eb;
    color:white;
    border:none;
    border-radius:10px;
    padding:12px;
    cursor:pointer;
    transition:0.3s;
}

.add-btn:hover{
    background:#1d4ed8;
}
